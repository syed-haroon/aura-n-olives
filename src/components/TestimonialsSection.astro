---
import { ExternalLink } from '@lucide/astro';
import { INSTAGRAM_TESTIMONIALS_URL, LINKEDIN_RECOMMENDATIONS_URL, TESTIMONIALS } from '../data/testimonials';

const [featured, ...supporting] = TESTIMONIALS;
---

<section class="bg-forest-950 py-20 sm:py-28" id="testimonials">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="fade-in grid gap-5 sm:grid-cols-[auto_1fr] sm:items-end sm:gap-10">
      <div>
        <p class="text-xs font-600 tracking-[0.18em] uppercase text-gold-400">Client recommendations</p>
        <h2 class="mt-3 max-w-xl font-display text-3xl sm:text-4xl font-700 leading-tight text-cream-50">
          What it feels like to be supported by Reshma
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-cream-200/70 sm:justify-self-end">
        Shared by real clients from recommendations published on LinkedIn, lightly edited for clarity.
      </p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-12 lg:gap-14">
      <figure class="fade-in lg:col-span-7 lg:border-r lg:border-cream-50/15 lg:pr-14">
        <span class="block font-display text-6xl leading-none text-gold-400/80" aria-hidden="true">“</span>
        <blockquote class="-mt-2 font-display text-2xl sm:text-3xl leading-snug text-cream-50">
          {featured.quote}
        </blockquote>
        <figcaption class="mt-8 flex items-center justify-between gap-4 border-t border-cream-50/15 pt-5">
          <span class="text-sm font-600 text-cream-100">{featured.name}</span>
          <a
            href={featured.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${featured.name}'s LinkedIn profile`}
            class="group inline-flex items-center gap-2 text-xs font-600 text-gold-300 hover:text-gold-400"
          >
            <ExternalLink class="h-4 w-4" />
            LinkedIn
            <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
          </a>
        </figcaption>
      </figure>

      <div class="lg:col-span-5">
        {supporting.map((testimonial, index) => (
          <figure class:list={['fade-in', index > 0 && 'mt-9 border-t border-cream-50/15 pt-9']}>
            <blockquote class="text-base sm:text-lg leading-relaxed text-cream-100/85">
              “{testimonial.quote}”
            </blockquote>
            <figcaption class="mt-5 flex items-center justify-between gap-4">
              <span class="text-sm font-600 text-cream-100">{testimonial.name}</span>
              <a
                href={testimonial.linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`View ${testimonial.name}'s LinkedIn profile`}
                class="group inline-flex items-center gap-2 text-xs font-600 text-gold-300 hover:text-gold-400"
              >
                <ExternalLink class="h-4 w-4" />
                LinkedIn
                <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="fade-in mt-12 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-7 border-t border-cream-50/15 pt-6 text-center">
      <a
        href={LINKEDIN_RECOMMENDATIONS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 text-sm font-600 text-gold-300 hover:text-gold-400"
      >
        <ExternalLink class="h-4 w-4" />
        View all recommendations on LinkedIn
        <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
      </a>
      <span class="hidden sm:block h-4 w-px bg-cream-50/20" aria-hidden="true"></span>
      <a
        href={INSTAGRAM_TESTIMONIALS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 text-sm font-600 text-gold-300 hover:text-gold-400"
      >
        <ExternalLink class="h-4 w-4" />
        Watch client stories on Instagram
        <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
