---
import { Mail, MessageCircle, UserPlus } from "@lucide/astro";
import { site, buildWhatsAppLink } from "../data/site";

const waLink = buildWhatsAppLink(`Hi Reshma, I'd like to know more about ${site.brandName}.`);
---

<footer class="bg-forest-950 text-forest-200 py-14">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row justify-between items-start gap-10 mb-10">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="relative h-11 w-11 shrink-0">
            <img src={site.logo} alt={`${site.brandName} logo`} class="block absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-16 w-16 max-w-none object-contain" />
          </span>
          <span>
            <span class="block font-display text-lg font-700 text-cream-50">{site.brandName}</span>
            <span class="block text-[11px] tracking-[0.15em] uppercase text-gold-400">{site.tagline}</span>
          </span>
        </div>
        <p class="text-sm leading-relaxed text-forest-300">
          {site.communityName}, helping yoga aspirants, enthusiasts, and yoga teachers to beat obesity and skinny fat through {site.methodName} (Yoga, Pranayama, Quantified Nutrition Diet & Strength Training).
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-10 sm:gap-14 text-sm">
        <div class="space-y-2.5">
          <div class="text-cream-50 font-600 text-xs uppercase tracking-wider mb-2">Explore</div>
          <a href="/" class="block hover:text-gold-400 transition-colors">Home</a>
          <a href="/programs" class="block hover:text-gold-400 transition-colors">Programs</a>
          <a href="/results" class="block hover:text-gold-400 transition-colors">Results</a>
          <a href="/about" class="block hover:text-gold-400 transition-colors">About</a>
          <a href="/#faq" class="block hover:text-gold-400 transition-colors">FAQ</a>
        </div>
        <div class="space-y-2.5">
          <div class="text-cream-50 font-600 text-xs uppercase tracking-wider mb-2">Connect</div>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 hover:text-gold-400 transition-colors">
            <MessageCircle class="h-4 w-4" /> {site.whatsappDisplay}
          </a>
          <a href={`mailto:${site.email}`} class="flex items-center gap-2.5 hover:text-gold-400 transition-colors">
            <Mail class="h-4 w-4" /> {site.email}
          </a>
          <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 hover:text-gold-400 transition-colors">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
            {site.instagramHandle}
          </a>
          <a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 hover:text-gold-400 transition-colors">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M5.2 3.5A2.2 2.2 0 1 1 5.2 8a2.2 2.2 0 0 1 0-4.5ZM3.3 9.5h3.8V21H3.3V9.5Zm6.2 0h3.6v1.6h.1c.5-1 1.8-2.1 3.8-2.1 4 0 4.7 2.6 4.7 6V21h-3.8v-5.3c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21H9.5V9.5Z"></path></svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>

    <div class="mb-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 border-y border-cream-50/10 py-6">
      <a href={site.registrationUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full bg-gold-500 px-5 py-3 text-sm font-700 text-forest-950 hover:bg-gold-400">
        <UserPlus class="h-4 w-4" /> Register for a program
      </a>
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full border border-cream-50/20 px-5 py-3 text-sm font-600 text-cream-50 hover:border-gold-400/60 hover:text-gold-300">
        <MessageCircle class="h-4 w-4" /> Chat on WhatsApp
      </a>
    </div>

    <div class="text-xs flex flex-col gap-2 text-center md:flex-row md:items-center md:justify-between md:text-left text-forest-400">
      <div>© {new Date().getFullYear()} {site.brandName}. All rights reserved.</div>
      <div>{site.founderName} · {site.founderTitle}</div>
    </div>
  </div>
</footer>
