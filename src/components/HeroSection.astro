---
import { site, buildWhatsAppLink } from "../data/site";

const waLink = buildWhatsAppLink(`Hi Reshma, I'd like to know more about the 90-Day Transformation Challenge.`);
---

<section class="hero-bg relative overflow-hidden pt-28 pb-20 sm:pt-36 sm:pb-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 grid lg:grid-cols-2 gap-12 items-center">
    <div class="fade-in">
      <div class="inline-flex items-center gap-2 mb-5 rounded-full border border-gold-400/30 bg-gold-400/10 px-4 py-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>
        <span class="text-xs font-600 tracking-[0.15em] uppercase text-gold-300">{site.communityName}</span>
      </div>

      <h1 class="font-display text-4xl sm:text-5xl lg:text-[3.4rem] font-800 leading-[1.1] text-cream-50">
        Embody the transformation <span class="text-gold-400 italic">you teach.</span>
      </h1>

      <p class="mt-6 text-base sm:text-lg text-cream-200/85 leading-relaxed max-w-xl">
        We help yoga teachers and yoga aspirants beat obesity and "skinny fat" through
        <strong class="text-gold-300 font-600"> {site.methodName}</strong>: Yoga, Pranayama, Quantified Nutrition Diet &amp; Strength Training, fused into one system.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-gold-500 hover:bg-gold-400 text-forest-950 font-700 px-6 py-3.5 rounded-full transition-colors text-sm"
        >
          Join the 90-Day Challenge
        </a>
        <a
          href="/programs"
          class="inline-flex items-center justify-center gap-2 border border-cream-50/25 hover:border-cream-50/50 text-cream-50 font-600 px-6 py-3.5 rounded-full transition-colors text-sm"
        >
          Explore All Programs
        </a>
      </div>

      <div class="mt-10 grid grid-cols-4 gap-3 max-w-md">
        {['Yoga', 'Pranayama', 'Quantified Nutrition Diet', 'Strength Training'].map((word) => (
          <div class="text-center">
            <div class="text-cream-50 font-display text-sm font-700">{word}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="fade-in relative">
      <div class="aspect-[4/5] w-full max-w-md mx-auto rounded-[2rem] border border-cream-50/10 shadow-soft overflow-hidden">
        <img
          src="/assets/images/founder/home-hero.webp"
          alt="Reshma standing in a calm yoga studio, with space for the home page message."
          width="896"
          height="1401"
          class="photo-frame-image"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="absolute -bottom-6 -left-6 hidden sm:block bg-cream-50 rounded-2xl shadow-soft px-5 py-4 max-w-[220px]">
        <div class="font-display text-2xl font-800 text-forest-900">90 Days</div>
        <div class="text-xs text-forest-600 mt-0.5">From skinny fat to strong, confident yogi</div>
      </div>
    </div>
  </div>
</section>
