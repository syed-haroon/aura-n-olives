---
import SectionHeader from "./SectionHeader.astro";
import type { Faq } from "../data/programs";

interface Props {
  faqs: Faq[];
  title?: string;
  eyebrow?: string;
  bgClass?: string;
}

const {
  faqs,
  title = "Frequently Asked Questions",
  eyebrow = "Before You Join",
  bgClass = "bg-cream-100",
} = Astro.props as Props;
---

<section class={`py-20 sm:py-28 ${bgClass}`} id="faq">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <SectionHeader eyebrow={eyebrow} title={title} />

    <div class="mt-12 space-y-3">
      {faqs.map((faq) => (
        <details class="fade-in group bg-white rounded-2xl border border-forest-900/8 open:border-gold-400/40 open:shadow-soft transition-colors">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4 px-5 py-4 sm:px-6 sm:py-5">
            <span class="font-600 text-forest-900 text-sm sm:text-base">{faq.q}</span>
            <span class="shrink-0 h-7 w-7 rounded-full bg-cream-100 text-forest-700 flex items-center justify-center text-sm group-open:bg-gold-500 group-open:text-forest-950 transition-colors">
              +
            </span>
          </summary>
          <p class="px-5 pb-5 sm:px-6 sm:pb-6 text-sm text-forest-700 leading-relaxed">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
