---
import { ExternalLink } from '@lucide/astro';
import type { Testimonial } from '../data/testimonials';
import { LINKEDIN_RECOMMENDATIONS_URL } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
  eyebrow?: string;
  title?: string;
  dark?: boolean;
}

const {
  testimonial,
  eyebrow = 'Client perspective',
  title = 'Support that stays personal',
  dark = false,
} = Astro.props as Props;
---

<section class:list={['py-16 sm:py-20', dark ? 'bg-forest-950' : 'bg-cream-100']}>
  <div class="fade-in max-w-4xl mx-auto px-4 sm:px-6">
    <div class="grid gap-8 md:grid-cols-[0.8fr_2fr] md:gap-12 md:items-start">
      <div>
        <p class="text-xs font-600 tracking-[0.18em] uppercase text-gold-600">{eyebrow}</p>
        <h2 class:list={['mt-3 font-display text-2xl sm:text-3xl font-700 leading-tight', dark ? 'text-cream-50' : 'text-forest-950']}>
          {title}
        </h2>
      </div>

      <figure class:list={['border-l-2 pl-6 sm:pl-8', dark ? 'border-gold-400/50' : 'border-gold-500/60']}>
        <blockquote class:list={['font-display text-xl sm:text-2xl leading-relaxed', dark ? 'text-cream-100' : 'text-forest-900']}>
          “{testimonial.quote}”
        </blockquote>
        <figcaption class:list={['mt-6 flex flex-wrap items-center justify-between gap-4 border-t pt-4', dark ? 'border-cream-50/15' : 'border-forest-900/10']}>
          <span class:list={['text-sm font-600', dark ? 'text-cream-100' : 'text-forest-900']}>{testimonial.name}</span>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <a
              href={testimonial.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-600 text-gold-600 hover:text-gold-500"
            >
              Profile <ExternalLink class="h-3.5 w-3.5" />
            </a>
            <a
              href={LINKEDIN_RECOMMENDATIONS_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-600 text-gold-600 hover:text-gold-500"
            >
              All recommendations <ExternalLink class="h-3.5 w-3.5" />
            </a>
          </div>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
