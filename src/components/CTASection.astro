---
import LeadForm from "./LeadForm.vue";
import { site } from "../data/site";

interface Props {
  context?: string;
  heading?: string;
  title?: string;
  description?: string;
}

const {
  context = site.brandName,
  heading = "Ready to begin?",
  title = "Your transformation starts with one message.",
  description = "Tell Reshma a little about yourself and she'll personally guide you to the right program.",
} = Astro.props as Props;
---

<section class="hero-bg py-20 sm:py-28">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 grid lg:grid-cols-2 gap-12 items-center">
    <div class="fade-in">
      <div class="flex items-center gap-2 mb-3">
        <span class="gold-line"></span>
        <span class="text-xs font-600 tracking-[0.2em] uppercase text-gold-300">Get Started</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-700 text-cream-50 leading-tight">{title}</h2>
      <p class="mt-4 text-cream-200/85 leading-relaxed">{description}</p>
    </div>

    <LeadForm client:load context={context} heading={heading} />
  </div>
</section>
