---
import "../styles/global.css";
import Navbar from "../components/Navbar.vue";
import FooterSection from "../components/FooterSection.astro";
import FadeInObserver from "../components/FadeInObserver.vue";
import StickyWhatsAppButton from "../components/StickyWhatsAppButton.vue";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  pageUrl?: string;
}

const {
  title = `${site.brandName} · ${site.tagline}`,
  description = `We help yoga teachers and yoga aspirants beat obesity and skinny fat through ${site.methodName}: Yoga, Pranayama, Quantified Nutrition Diet & Strength Training.`,
  ogImage = `${site.siteUrl}/assets/images/og/home-og.webp`,
  ogType = "website",
  pageUrl,
} = Astro.props as Props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl ?? site.siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl ?? site.siteUrl} />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="bg-cream-50 text-forest-950">
    <Navbar client:load currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <FooterSection />
    <StickyWhatsAppButton client:load />
    <FadeInObserver client:load />
  </body>
</html>
