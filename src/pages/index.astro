---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import ProblemSection from "../components/ProblemSection.astro";
import MethodSection from "../components/MethodSection.astro";
import ResultsTeaser from "../components/ResultsTeaser.astro";
import AboutTeaser from "../components/AboutTeaser.astro";
import ProgramsGrid from "../components/ProgramsGrid.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import FaqSection from "../components/FaqSection.astro";
import CTASection from "../components/CTASection.astro";
import { getProgramBySlug } from "../data/programs";

const challenge = getProgramBySlug('wellness-warrior-challenge');
const membership = getProgramBySlug('yoga-sadhana');

const homeFaqs = [
  challenge?.faqs[0],
  challenge?.faqs[1],
  challenge?.faqs[3],
  membership?.faqs[0],
].filter((faq) => faq !== undefined);
---

<Layout pageUrl="https://auraandolives.com/" ogImage="https://auraandolives.com/assets/images/og/home-og.webp">
  <HeroSection />
  <ProblemSection />
  <MethodSection />
  <ResultsTeaser />
  <AboutTeaser />
  <ProgramsGrid />
  <TestimonialsSection />
  <FaqSection faqs={homeFaqs} eyebrow="Common Questions" title="Before You Reach Out" />
  <CTASection />
</Layout>
