---
import Layout from "../../layouts/Layout.astro";
import ProgramsGrid from "../../components/ProgramsGrid.astro";
import CTASection from "../../components/CTASection.astro";
import { site } from "../../data/site";
---

<Layout
  title={`Programs | ${site.brandName}`}
  description={`Explore the programs for working with ${site.founderName}: the 90-day Wellness Warrior Challenge and the Yoga Sadhana membership, both built on ${site.methodName}.`}
  pageUrl="https://auraandolives.com/programs/"
  ogImage="https://auraandolives.com/assets/images/og/programs-og.webp"
>
  <section
    class="hero-bg hero-photo-bg pt-28 pb-16 sm:pt-36 sm:pb-20"
    style="--hero-image: url('/assets/images/heroes/programs-hero.webp'); --hero-position: center 25%;"
  >
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <div
        class="fade-in inline-flex items-center gap-2 mb-5 rounded-full border border-gold-400/30 bg-gold-400/10 px-4 py-1.5"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>
        <span class="text-xs font-600 tracking-[0.15em] uppercase text-gold-300"
          >Programs</span
        >
      </div>
      <h1
        class="fade-in font-display text-4xl sm:text-5xl font-800 leading-[1.1] text-cream-50"
      >
        Transform in 90 days. Sustain it for life.
      </h1>
      <p
        class="fade-in mt-6 text-cream-200/85 leading-relaxed text-base sm:text-lg"
      >
        Start with the Wellness Warrior Challenge to rebuild your body in 90
        days, or join Yoga Sadhana for daily practice and ongoing
        accountability. Both are built on the Yogi Recomposition Method.
      </p>
    </div>
  </section>

  <ProgramsGrid showHeader={false} />

  <CTASection
    heading="Not sure which is right for you?"
    title="Tell us your goal: we'll point you to the right program."
    description="A quick message is all it takes. Reshma personally helps you choose the best fit."
  />
</Layout>
