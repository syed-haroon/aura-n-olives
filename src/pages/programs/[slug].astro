---
import { Flower2, Wind, Apple, Dumbbell, Check } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
import FaqSection from "../../components/FaqSection.astro";
import CTASection from "../../components/CTASection.astro";
import TestimonialSpotlight from "../../components/TestimonialSpotlight.astro";
import { PROGRAMS, getAllProgramSlugs, getProgramBySlug, type Program } from "../../data/programs";
import { site, buildWhatsAppLink } from "../../data/site";
import { TESTIMONIALS } from "../../data/testimonials";

export async function getStaticPaths() {
  return getAllProgramSlugs().map((slug) => ({
    params: { slug },
    props: { program: getProgramBySlug(slug) },
  }));
}

interface Props {
  program: Program | undefined;
}

const { program } = Astro.props as Props;

if (!program) {
  return Astro.redirect("/programs");
}

const pageTitle = `${program.name} | ${site.brandName}`;
const pageDesc = `${program.tagline}. ${program.heroDescription}`;
const pageUrl = `${site.siteUrl}/programs/${program.slug}`;

const PILLAR_ICONS: Record<string, any> = { Yoga: Flower2, Pranayama: Wind, "Quantified Nutrition Diet": Apple, "Strength Training": Dumbbell };

const waLink = buildWhatsAppLink(`Hi Reshma, I'd like to know more about ${program.name}.`);

const otherPrograms = PROGRAMS.filter((s) => s.slug !== program.slug);
const testimonial = program.slug === 'wellness-warrior-challenge' ? TESTIMONIALS[1] : TESTIMONIALS[0];

const PROGRAM_HERO_MEDIA: Record<string, { src: string; alt: string; position?: string }> = {
  'wellness-warrior-challenge': {
    src: '/assets/images/programs/challenge-hero.webp',
    alt: 'Reshma leading an energizing yoga-and-strength transformation session with Indian women students.',
    position: 'center top',
  },
  'yoga-sadhana': {
    src: '/assets/images/programs/membership-hero.webp',
    alt: 'Reshma sitting with her wellness community in a warm studio circle.',
    position: 'center top',
  },
};

const heroMedia = PROGRAM_HERO_MEDIA[program.slug];
const PROGRAM_OG_MEDIA: Record<string, string> = {
  'wellness-warrior-challenge': 'https://auraandolives.com/assets/images/og/challenge-og.webp',
  'yoga-sadhana': 'https://auraandolives.com/assets/images/og/membership-og.webp',
};
const pageOgImage = PROGRAM_OG_MEDIA[program.slug] ?? 'https://auraandolives.com/assets/images/og/programs-og.webp';
---

<Layout title={pageTitle} description={pageDesc} pageUrl={pageUrl} ogImage={pageOgImage} ogType="website">

  <!-- Hero -->
  <section
    class:list={['hero-bg pt-28 pb-16 sm:pt-36 sm:pb-20', heroMedia && 'hero-photo-bg']}
    style={heroMedia ? `--hero-image: url('${heroMedia.src}'); --hero-position: ${heroMedia.position ?? 'center 25%'};` : undefined}
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="fade-in inline-flex items-center gap-2 mb-5 rounded-full border border-gold-400/30 bg-gold-400/10 px-4 py-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>
        <span class="text-xs font-600 tracking-[0.15em] uppercase text-gold-300">{program.category}</span>
      </div>
      <h1 class="fade-in font-display text-4xl sm:text-5xl font-800 leading-[1.1] text-cream-50">
        {program.name}
      </h1>
      <p class="fade-in mt-4 text-gold-300 font-600 text-lg">{program.tagline}</p>
      <p class="fade-in mt-6 text-cream-200/85 leading-relaxed text-base sm:text-lg max-w-2xl mx-auto">
        {program.heroDescription}
      </p>
      <p class="fade-in mt-4 text-xs tracking-wide uppercase text-cream-200/60">{program.format}</p>

      <div class="fade-in mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-gold-500 hover:bg-gold-400 text-forest-950 font-700 px-6 py-3.5 rounded-full transition-colors text-sm"
        >
          {program.ctaLabel}
        </a>
        <a
          href="#apply"
          class="inline-flex items-center justify-center gap-2 border border-cream-50/25 hover:border-cream-50/50 text-cream-50 font-600 px-6 py-3.5 rounded-full transition-colors text-sm"
        >
          Get Details on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Is this for you -->
  <section class="py-16 sm:py-20 bg-cream-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="fade-in font-display text-2xl sm:text-3xl font-700 text-forest-950 text-center mb-4">Is this for you?</h2>
      <p class="fade-in text-center text-forest-600 mb-10 max-w-xl mx-auto text-sm">This program is built for:</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {program.idealFor.map((item) => (
          <div class="fade-in flex items-start gap-3 bg-cream-100 rounded-2xl p-5">
            <Check class="w-5 h-5 text-gold-600 shrink-0 mt-0.5" stroke-width={2.5} />
            <p class="text-sm text-forest-800 leading-relaxed">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pain points -->
  <section class="py-16 sm:py-20 bg-cream-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="fade-in font-display text-2xl sm:text-3xl font-700 text-forest-950 text-center mb-10">You might recognize yourself here</h2>
      <div class="space-y-3">
        {program.painPoints.map((point) => (
          <div class="fade-in flex items-start gap-3 bg-white rounded-2xl border border-forest-900/8 p-5">
            <span class="mt-1 shrink-0 h-5 w-5 rounded-full bg-gold-100 text-gold-700 text-xs font-700 flex items-center justify-center">✓</span>
            <p class="text-sm text-forest-800 leading-relaxed">{point}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Method pillars -->
  <section class="py-16 sm:py-20 bg-forest-950 text-cream-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="fade-in font-display text-2xl sm:text-3xl font-700 text-center mb-3">Built on {site.methodName}</h2>
      <p class="fade-in text-center text-cream-200/70 text-sm mb-12">The same four fused pillars, applied to this program</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {program.pillars.map((pillar) => {
          const Icon = PILLAR_ICONS[pillar.title] ?? Flower2;
          return (
            <div class="fade-in bg-cream-50/5 border border-cream-50/10 rounded-2xl p-6">
              <div class="h-10 w-10 rounded-full bg-gold-500 text-forest-950 flex items-center justify-center mb-4">
                <Icon class="w-5 h-5" stroke-width={2} />
              </div>
              <h3 class="font-display text-base font-700 mb-2">{pillar.title}</h3>
              <p class="text-xs text-cream-200/75 leading-relaxed">{pillar.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- What you get + Outcomes -->
  <section class="py-16 sm:py-20 bg-cream-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 grid md:grid-cols-2 gap-10">
      <div class="fade-in">
        <h2 class="font-display text-2xl font-700 text-forest-950 mb-6">What you get</h2>
        <ul class="space-y-3">
          {program.whatYouGet.map((item) => (
            <li class="flex items-start gap-3 text-sm text-forest-800 leading-relaxed">
              <Check class="w-4 h-4 text-gold-600 shrink-0 mt-1" stroke-width={2.5} />
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="fade-in">
        <h2 class="font-display text-2xl font-700 text-forest-950 mb-6">Outcomes you'll achieve</h2>
        <ul class="space-y-3">
          {program.outcomes.map((item) => (
            <li class="flex items-start gap-3 text-sm text-forest-800 leading-relaxed">
              <span class="w-4 h-4 rounded-full bg-forest-900 text-gold-400 text-[9px] font-700 flex items-center justify-center shrink-0 mt-1">★</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <TestimonialSpotlight
    testimonial={testimonial}
    eyebrow="A client’s experience"
    title={program.slug === 'wellness-warrior-challenge' ? 'A plan built around real life' : 'Practice with steady support'}
    dark
  />

  <FaqSection faqs={program.faqs} eyebrow="Before You Join" title={`Questions about ${program.shortName}`} bgClass="bg-cream-100" />

  <div id="apply">
    <CTASection
      context={program.name}
      heading={program.ctaLabel}
      title={`Ready to join ${program.shortName}?`}
      description="Fill this in and Reshma's team will reach out on WhatsApp personally. No bots, no funnels."
    />
  </div>

  <!-- Other programs -->
  <section class="py-16 sm:py-20 bg-cream-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="fade-in font-display text-2xl font-700 text-forest-950 text-center mb-10">Explore other programs</h2>
      <div class="flex justify-center">
        {otherPrograms.map((s) => (
          <a href={`/programs/${s.slug}`} class="fade-in block w-full sm:max-w-md bg-white rounded-2xl border border-forest-900/8 p-5 hover:shadow-soft hover:-translate-y-1 transition-all">
            <span class="text-[10px] font-600 tracking-[0.15em] uppercase text-gold-600">{s.category}</span>
            <h3 class="font-display text-base font-700 text-forest-950 mt-1.5 mb-2">{s.name}</h3>
            <p class="text-xs text-forest-600 leading-relaxed">{s.cardBlurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
